<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
        <OtherFlags>$(OtherFlags) --warnon:3390</OtherFlags>
    </PropertyGroup>

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageId>FSharp.Data.Rocq</PackageId>
        <Description>Typed access to a compiled Rocq project: sentences, declarations, proofs, comments, resolved references and cross-file dependencies, read from .v and .glob files without running Rocq. Can also write the project as JSON.</Description>
        <PackageTags>rocq;coq;fsharp;glob;proof-assistant;parser</PackageTags>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="Source.fs" />
        <Compile Include="Lexer.fs" />
        <Compile Include="Glob.fs" />
        <Compile Include="Structure.fs" />
        <Compile Include="Project.fs" />
        <Compile Include="Shard.fs" />
        <Compile Include="Extract.fs" />
    </ItemGroup>

</Project>

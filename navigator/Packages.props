<Project>

    <!--
        Cohort alignment, 2026-11-23.
        Set: View and View.Dom 0.4.0, Fable.Ranvier.View.Anime 0.1.47, Css 0.3.0 with Css.Bindings and Css.Build 0.2.0 and
        Css.View 0.3.1, Wire 0.2.1, Fable.Ranvier.Dom 0.1.0, and Expecto 11.1.1.
        Client compiler: Fickl 0.13.0, pinned in .config/dotnet-tools.json.
        Mounting: server render with one IdPrefix per island, hydrate per host with Strict = true. Island markup enters the
        finished document, since div.unsafeHtml rejects root markers. Head marks are stripped, since hydration removes them.
    -->
    <PropertyGroup>
        <NacaraCoreVersion>2.0.0-beta.6</NacaraCoreVersion>
        <NacaraMarkdownVersion>1.0.0-beta.2</NacaraMarkdownVersion>
        <NacaraLinkValidatorVersion>1.0.0-beta.2</NacaraLinkValidatorVersion>
        <NacaraNuglifyVersion>1.0.0-beta.1</NacaraNuglifyVersion>
        <RanvierViewVersion>0.4.0</RanvierViewVersion>
        <RanvierViewAnimeVersion>0.1.47</RanvierViewAnimeVersion>
        <RanvierCssVersion>0.3.0</RanvierCssVersion>
        <RanvierCssBindingsVersion>0.2.0</RanvierCssBindingsVersion>
        <RanvierCssBuildVersion>0.2.0</RanvierCssBuildVersion>
        <RanvierCssViewVersion>0.3.1</RanvierCssViewVersion>
        <RanvierWireVersion>0.2.1</RanvierWireVersion>
        <FableRanvierDomVersion>0.1.0</FableRanvierDomVersion>
        <MarkdigVersion>1.3.2</MarkdigVersion>
        <ExpectoVersion>11.1.1</ExpectoVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- Nacara.Core 2.0.0-beta.6 asks for 10.1.300, above an older 10.0 SDK's implicit version. 10.1.404 matches 10.0.404. -->
        <PackageReference Update="FSharp.Core" Version="10.1.404" />
    </ItemGroup>

</Project>

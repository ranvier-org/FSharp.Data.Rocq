<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <InvariantGlobalization>true</InvariantGlobalization>
        <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    </PropertyGroup>

    <Import Project="..\Packages.props" />

    <ItemGroup>
        <Compile Include="FixtureFiles.fs" />
        <Compile Include="FactsTests.fs" />
        <Compile Include="SourceTests.fs" />
        <Compile Include="HighlightTests.fs" />
        <Compile Include="DocsTests.fs" />
        <Compile Include="ArticleTests.fs" />
        <Compile Include="GuaranteesTests.fs" />
        <Compile Include="PluginTests.fs" />
        <Compile Include="TokenTests.fs" />
        <Compile Include="RankingTests.fs" />
        <Compile Include="CorpusTests.fs" />
        <Compile Include="Main.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Nacara.Plugin.Rocq\Nacara.Plugin.Rocq.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Expecto" Version="$(ExpectoVersion)" />
        <PackageReference Include="Nacara.Plugin.Markdown" Version="$(NacaraMarkdownVersion)" />
        <PackageReference Include="Nacara.Plugin.LinkValidator" Version="$(NacaraLinkValidatorVersion)" />
        <PackageReference Include="Nacara.Plugin.Assets.Nuglify" Version="$(NacaraNuglifyVersion)" />
    </ItemGroup>

</Project>
